# ─────────────────────────────────────────────
# civic-ops — environment variables template
# Copy to .env and fill in real values.
# Never commit .env to version control.
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/civic_ops_dev?schema=public"

# ── Auth ──────────────────────────────────────
# Secret used to sign JWT access tokens (min 32 chars)
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"

# Secret used to sign JWT refresh tokens (min 32 chars)
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"

# Access token TTL (e.g. 15m, 1h)
JWT_ACCESS_EXPIRES_IN="15m"

# Refresh token TTL (e.g. 7d, 30d)
JWT_REFRESH_EXPIRES_IN="7d"

# ── Server ────────────────────────────────────
PORT="3000"
NODE_ENV="development"

# ── AI Provider ───────────────────────────────
# OpenAI API key (used by AiGateway / OpenAiProvider)
OPENAI_API_KEY="sk-..."

# OpenAI model to use for summaries and extraction
OPENAI_MODEL="gpt-4o-mini"

# ── Logging ───────────────────────────────────
# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL="info"
